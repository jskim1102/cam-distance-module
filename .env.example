MEDIAMTX_API_PORT=10003
MEDIAMTX_RTSP_PORT=8560
MEDIAMTX_WEBRTC_PORT=8895
MEDIAMTX_ICE_UDP_PORT=8195
MEDIAMTX_WEBRTC_HOST=
